---
// Layout base
import { ViewTransitions } from 'astro:transitions';
const {
  title = 'Tech con Sentido',
  description = 'Portafolio y blog de Adrian Lopez — desarrollador y creador de contenido tech.',
  ogImage,
  canonical = new URL(Astro.url.pathname, Astro.site),
  type = 'website',
  jsonLd,
} = Astro.props;

const jsonLdBlocks: Record<string, unknown>[] = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Tech con Sentido — RSS" href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta name="theme-color" content="#282828" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Tech con Sentido" />
    <meta property="og:locale" content="es_MX" />
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image" content={ogImage} />
        </>
      )
    }
    {
      !ogImage && <meta name="twitter:card" content="summary" />
    }
    {
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
    <ViewTransitions />
    <style>
      :root {
        --indigo: #83a598;
        --bg: #282828;
        --card: #3c3836;
        --text: #ebdbb2;
        --muted: #a89984;
        /* Ancho del contenedor: en pantallas anchas el contenido ocupa
           el espacio muerto que dejaba el antiguo max-width de 900px. */
        --shell: 1240px;
        --pad: clamp(1rem, 4vw, 2.5rem);
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: system-ui, -apple-system, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
      }
      header { border-bottom: 1px solid #504945; }
      .bar {
        max-width: var(--shell);
        margin: 0 auto;
        padding: 1.4rem var(--pad);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
      }
      .logo { font-weight: 700; font-size: 1.2rem; color: #fbf1c7; text-decoration: none; }
      .logo span { color: var(--indigo); }
      nav a { color: var(--muted); text-decoration: none; margin-left: 1.5rem; }
      nav a:hover { color: #fbf1c7; }
      main { max-width: var(--shell); margin: 0 auto; padding: 3rem var(--pad); }
      /* El hero vive en la portada (otro componente): sin :global() Astro
         elimina estas reglas por no encontrar el elemento en este archivo. */
      :global(.hero h1) { font-size: 2.6rem; line-height: 1.15; margin-bottom: 1rem; }
      :global(.hero h1 .accent) { color: var(--indigo); }
      :global(.hero p) { color: var(--muted); font-size: 1.15rem; max-width: 62ch; }
      @media (min-width: 1024px) {
        :global(.hero h1) { font-size: 3.1rem; max-width: 24ch; }
        :global(.hero p) { font-size: 1.2rem; max-width: 66ch; }
      }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; margin-top: 3rem; }
      .card {
        background: var(--card);
        border: 1px solid #504945;
        border-radius: 12px;
        padding: 1.5rem;
        transition: transform .2s, border-color .2s;
      }
      .card:hover { transform: translateY(-4px); border-color: var(--indigo); }
      .card h3 { margin-bottom: .5rem; }
      .card p { color: var(--muted); font-size: .95rem; }
      .tag {
        --cat: #d3869b;
        display: inline-block;
        background: color-mix(in srgb, var(--cat) 20%, transparent);
        border: 1px solid color-mix(in srgb, var(--cat) 40%, transparent);
        color: color-mix(in srgb, var(--cat) 72%, #fbf1c7);
        font-weight: 600;
        font-size: .75rem;
        padding: .18rem .65rem;
        border-radius: 20px;
        margin-top: .8rem;
      }
      footer { color: var(--muted); border-top: 1px solid #504945; font-size: .9rem; }
      .footer-inner {
        max-width: var(--shell);
        margin: 0 auto;
        padding: 2rem var(--pad);
        text-align: center;
      }
      .footer-inner a { color: var(--indigo); text-decoration: none; }
      .footer-inner a:hover { text-decoration: underline; }
      /* Animación de entrada suave para el contenido */
      main { animation: fadeUp .5s ease both; }
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
      }
      /* Transición de página con View Transitions API */
      ::view-transition-old(root) { animation: fadeOut .25s ease both; }
      ::view-transition-new(root) { animation: fadeUp .35s ease both; }
      @keyframes fadeOut { from { opacity: 1; } to { opacity: 0; } }
      @media (prefers-reduced-motion: reduce) {
        main, ::view-transition-old(root), ::view-transition-new(root) { animation: none; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="bar">
        <a class="logo" href="/">Tech con <span>Sentido</span></a>
        <nav>
          <a href="/">Inicio</a>
          <a href="/blog">Blog</a>
          <a href="/proyectos">Proyectos</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-inner">
        © 2026 Adrian Lopez · Hecho con Astro · Hosteado en Cloudflare Pages
        · <a href="/rss.xml">RSS</a>
      </div>
    </footer>
  </body>
</html>
