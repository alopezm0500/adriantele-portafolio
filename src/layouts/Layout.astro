---
// Layout base
import { ViewTransitions } from 'astro:transitions';
const {
  title = 'Adrian — Portafolio',
  description = 'Portafolio y blog de Adrian Lopez — desarrollador y creador de contenido tech.',
  ogImage,
  canonical = new URL(Astro.url.pathname, Astro.site),
  type = 'website',
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Blog de Adrian — RSS" href="/rss.xml" />
    <meta name="theme-color" content="#0f1117" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Adrian — Portafolio" />
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image" content={ogImage} />
        </>
      )
    }
    {
      !ogImage && <meta name="twitter:card" content="summary" />
    }
    <ViewTransitions />
    <style>
      :root {
        --indigo: #2B21E0;
        --bg: #0f1117;
        --card: #1a1d27;
        --text: #e6e8ee;
        --muted: #9aa0b0;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: system-ui, -apple-system, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
      }
      header {
        padding: 1.5rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #262a36;
      }
      .logo { font-weight: 700; font-size: 1.2rem; color: #fff; }
      .logo span { color: var(--indigo); }
      nav a { color: var(--muted); text-decoration: none; margin-left: 1.5rem; }
      nav a:hover { color: #fff; }
      main { max-width: 900px; margin: 0 auto; padding: 3rem 2rem; }
      .hero h1 { font-size: 2.6rem; line-height: 1.2; margin-bottom: 1rem; }
      .hero h1 .accent { color: var(--indigo); }
      .hero p { color: var(--muted); font-size: 1.15rem; max-width: 600px; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; margin-top: 3rem; }
      .card {
        background: var(--card);
        border: 1px solid #262a36;
        border-radius: 12px;
        padding: 1.5rem;
        transition: transform .2s, border-color .2s;
      }
      .card:hover { transform: translateY(-4px); border-color: var(--indigo); }
      .card h3 { margin-bottom: .5rem; }
      .card p { color: var(--muted); font-size: .95rem; }
      .tag {
        display: inline-block;
        background: rgba(43,33,224,.15);
        color: #8b85ff;
        font-size: .75rem;
        padding: .2rem .6rem;
        border-radius: 20px;
        margin-top: .8rem;
      }
      footer { text-align: center; color: var(--muted); padding: 2rem; border-top: 1px solid #262a36; font-size: .9rem; }
      /* Animación de entrada suave para el contenido */
      main { animation: fadeUp .5s ease both; }
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
      }
      /* Transición de página con View Transitions API */
      ::view-transition-old(root) { animation: fadeOut .25s ease both; }
      ::view-transition-new(root) { animation: fadeUp .35s ease both; }
      @keyframes fadeOut { from { opacity: 1; } to { opacity: 0; } }
      @media (prefers-reduced-motion: reduce) {
        main, ::view-transition-old(root), ::view-transition-new(root) { animation: none; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="logo">Adrian<span>.</span>dev</div>
      <nav>
        <a href="/">Inicio</a>
        <a href="/blog">Blog</a>
        <a href="/proyectos">Proyectos</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      © 2026 Adrian Lopez · Hecho con Astro · Hosteado en Cloudflare Pages
      · <a href="/rss.xml">RSS</a>
    </footer>
  </body>
</html>
