---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
---
<Layout
  title="Blog — Adrian"
  description="Artículos sobre telecomunicaciones, IA y tecnología con pensamiento crítico."
>
  <section class="blog-head">
    <h1>📝 Blog</h1>
    <p>Telecomunicaciones, IA y tecnología con pensamiento crítico. {posts.length} artículos publicados.</p>
  </section>

  <section class="grid">
    {posts.map((post, i) => <PostCard post={post} eager={i === 0} />)}
  </section>
</Layout>

<style>
  .blog-head h1 { font-size: 2.2rem; }
  .blog-head p { color: var(--muted); margin-top: .5rem; }
  .grid { margin-top: 2.5rem; }
</style>
