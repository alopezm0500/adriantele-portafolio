---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
---
<Layout
  title="Blog — Adrian"
  description="Artículos sobre tecnología con pensamiento crítico: Tech con Sentido, portafolio y proyectos."
>
  <section class="blog-head">
    <h1>📝 Blog</h1>
    <p>El blog completo: tecnología con pensamiento crítico, Telecom y operaciones. {posts.length} artículos publicados.</p>
  </section>

  <section class="grid">
    {posts.map((post, i) => <PostCard post={post} eager={i === 0} />)}
  </section>
</Layout>

<style>
  .blog-head h1 { font-size: 2.2rem; }
  .blog-head p { color: var(--muted); margin-top: .5rem; }
  .telecom-note {
    margin-top: 1rem;
    color: var(--muted);
    font-size: .92rem;
    padding: .7rem 1rem;
    background: color-mix(in srgb, var(--indigo) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--indigo) 30%, transparent);
    border-radius: 10px;
  }
  .telecom-note a { color: var(--text); font-weight: 600; }
  .telecom-note a:hover { color: #fbf1c7; text-decoration: underline; }
  /* Listado editorial: tarjetas horizontales a una columna */
  .grid {
    margin-top: 2.5rem;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
</style>
