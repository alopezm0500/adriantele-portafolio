---
import Layout from '../../layouts/Layout.astro';
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { CATEGORIES, catColor, catName, fmtDate, readingTime } from '../../lib/blog';
import { extractHeadings } from '../../lib/toc.mjs';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const minutes = readingTime(post.body);
const date = fmtDate(post.data.pubDate);
const byDateDesc = (a, b) =>
  new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf();
const allPosts = await getCollection('blog');
const related = allPosts
  .filter((p) => p.slug !== post.slug && p.data.categories.some((c) => post.data.categories.includes(c)))
  .sort(byDateDesc)
  .slice(0, 3);

// Barra lateral: mismos relacionados y, si no llegan a 3, se completan
// con los artículos más recientes.
const sidebarRelated = related.slice(0, 3);
if (sidebarRelated.length < 3) {
  const taken = new Set([post.slug, ...sidebarRelated.map((p) => p.slug)]);
  const recent = allPosts.filter((p) => p.slug !== post.slug).sort(byDateDesc);
  for (const p of recent) {
    if (sidebarRelated.length >= 3) break;
    if (!taken.has(p.slug)) {
      sidebarRelated.push(p);
      taken.add(p.slug);
    }
  }
}

// TOC generado en build time a partir de los h2/h3 del markdown.
const toc = extractHeadings(post.body);

let ogImage;
if (post.data.heroImage) {
  const optimized = await getImage({
    src: post.data.heroImage,
    width: 1200,
  });
  ogImage = new URL(optimized.src, Astro.site).href;
}
const pageUrl = new URL(`/blog/${post.slug}/`, Astro.site).href;
const siteUrl = Astro.site!.href;
const words = post.body.trim().split(/\s+/).length;
const sectionNames = post.data.categories.map((c) => catName(c));
const primaryCat = post.data.categories.find((c) => c in CATEGORIES);

// Datos estructurados: artículo + migas de pan (para resultados enriquecidos).
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    ...(ogImage ? { image: [ogImage] } : {}),
    datePublished: post.data.pubDate,
    dateModified: post.data.pubDate,
    inLanguage: 'es-MX',
    wordCount: words,
    articleSection: sectionNames,
    url: pageUrl,
    mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
    author: {
      '@type': 'Person',
      name: 'Adrian López',
      url: siteUrl,
      sameAs: ['https://github.com/alopezm0500'],
    },
    publisher: { '@type': 'Person', name: 'Adrian López' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site).href },
      ...(primaryCat
        ? [
            {
              '@type': 'ListItem',
              position: 3,
              name: catName(primaryCat),
              item: new URL(`/blog/categoria/${primaryCat}/`, Astro.site).href,
            },
          ]
        : []),
      {
        '@type': 'ListItem',
        position: primaryCat ? 4 : 3,
        name: post.data.title,
        item: pageUrl,
      },
    ],
  },
];
---
<Layout
  title={`${post.data.title} — Tech con Sentido`}
  description={post.data.description}
  ogImage={ogImage}
  type="article"
  jsonLd={jsonLd}
>
  <div class="post-layout">
    <article class="post">
      {
        post.data.heroImage && (
          <Image
            class="hero-img"
            src={post.data.heroImage}
            alt={`Portada de: ${post.data.title}`}
            width={1200}
          />
        )
      }
      <header class="post-header">
        <div class="post-meta">
          <div class="chips">
            {post.data.categories.map((c) => <span class="tag" style={`--cat:${catColor(c)}`}>{catName(c)}</span>)}
          </div>
          <time datetime={post.data.pubDate}>{date}</time>
        </div>
        <h1>{post.data.title}</h1>
        <p class="meta-line">✍️ Por Adrian López · 📖 {minutes} min de lectura</p>
        <p class="description">{post.data.description}</p>
      </header>

      <div class="content">
        <Content />
      </div>

      <footer class="post-footer">
        <div class="footer-row">
          <a href="/blog">← Volver al blog</a>
        </div>
        {
          related.length > 0 && (
            <section class="related">
              <h2>📚 Sigue leyendo</h2>
              <div class="related-grid">
                {related.map((p) => (
                  <a class="related-card" href={`/blog/${p.slug}/`}>
                    <span class="tag" style={`--cat:${catColor(p.data.categories[0])}`}>{catName(p.data.categories[0])}</span>
                    <h3>{p.data.title}</h3>
                    <time datetime={p.data.pubDate}>{fmtDate(p.data.pubDate)}</time>
                  </a>
                ))}
              </div>
            </section>
          )
        }
      </footer>
    </article>

    <aside class="sidebar" aria-label="Navegación del artículo">
      {
        toc.length > 0 && (
          <section class="side-block">
            <h2 class="side-title">En este artículo</h2>
            <nav class="toc" data-toc>
              <ul>
                {toc.map((h) => (
                  <li class={h.depth === 3 ? 'lvl-3' : 'lvl-2'}>
                    <a href={`#${h.id}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </section>
        )
      }

      {
        sidebarRelated.length > 0 && (
          <section class="side-block">
            <h2 class="side-title">Sigue leyendo</h2>
            <ul class="side-list">
              {sidebarRelated.map((p) => (
                <li>
                  <a href={`/blog/${p.slug}/`}>
                    <span class="tag" style={`--cat:${catColor(p.data.categories[0])}`}>{catName(p.data.categories[0])}</span>
                    <span class="side-post-title">{p.data.title}</span>
                    <time datetime={p.data.pubDate}>{fmtDate(p.data.pubDate)}</time>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </aside>
  </div>

  <script>
    // Scroll-spy del TOC: IntersectionObserver puro, sin dependencias.
    function initToc() {
      const toc = document.querySelector<HTMLElement>('[data-toc]');
      if (!toc || toc.dataset.ready === '1') return;
      toc.dataset.ready = '1';

      const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
      if (!links.length) return;

      const pairs = links
        .map((link) => {
          const id = decodeURIComponent((link.getAttribute('href') || '').slice(1));
          const heading = document.getElementById(id);
          return heading ? { link, heading } : null;
        })
        .filter((pair): pair is { link: HTMLAnchorElement; heading: HTMLElement } => pair !== null);
      if (!pairs.length) return;

      const setActive = (id: string) => {
        links.forEach((link) => link.classList.toggle('active', link.getAttribute('href') === `#${id}`));
      };

      // Encabezado activo = el último cuyo top ya pasó el umbral de lectura.
      const OFFSET = 96;
      const select = () => {
        let current: HTMLElement | null = null;
        for (const pair of pairs) {
          if (pair.heading.getBoundingClientRect().top - OFFSET <= 0) current = pair.heading;
          else break;
        }
        setActive(current ? current.id : '');
      };

      const observer = new IntersectionObserver(select, {
        rootMargin: `-${OFFSET}px 0px -55% 0px`,
        threshold: 0,
      });
      pairs.forEach((pair) => observer.observe(pair.heading));

      links.forEach((link) => {
        link.addEventListener('click', () => {
          setActive(decodeURIComponent((link.getAttribute('href') || '').slice(1)));
        });
      });

      select();
    }

    document.addEventListener('astro:page-load', initToc);
    if (document.readyState === 'complete') initToc();
  </script>
</Layout>

<style>
  /* Dos columnas solo en escritorio ancho: la lectura se queda en 860px
     y la barra lateral ocupa el espacio sobrante (sticky). */
  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 860px);
    justify-content: center;
    align-items: start;
    gap: 2rem;
  }
  .post { max-width: 860px; width: 100%; margin: 0; }
  .sidebar { display: none; }
  @media (min-width: 1280px) {
    .post-layout { grid-template-columns: minmax(0, 860px) 250px; }
    .sidebar {
      display: block;
      position: sticky;
      top: 2rem;
      align-self: start;
      max-height: calc(100vh - 4rem);
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: #504945 transparent;
    }
  }
  .side-block {
    background: var(--card);
    border: 1px solid #504945;
    border-radius: 12px;
    padding: 1rem 1.1rem;
    margin-bottom: 1.25rem;
  }
  .side-block:last-child { margin-bottom: 0; }
  .side-title {
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--muted);
    font-weight: 600;
    margin-bottom: .7rem;
  }
  .toc ul { list-style: none; margin: 0; padding: 0; }
  .toc li { margin: 0; }
  .toc a {
    display: block;
    color: var(--muted);
    text-decoration: none;
    font-size: .84rem;
    line-height: 1.35;
    padding: .28rem 0 .28rem .65rem;
    border-left: 2px solid transparent;
    transition: color .15s, border-color .15s;
  }
  .toc li.lvl-3 a { padding-left: 1.1rem; font-size: .79rem; }
  .toc a:hover { color: #fbf1c7; }
  .toc a.active { color: var(--indigo); border-left-color: var(--indigo); }
  .side-list { list-style: none; margin: 0; padding: 0; }
  .side-list li { margin-bottom: .85rem; }
  .side-list li:last-child { margin-bottom: 0; }
  .side-list a { display: block; text-decoration: none; }
  .side-list .tag { margin: 0 0 .35rem; font-size: .62rem; padding: .1rem .5rem; }
  .side-post-title {
    display: block;
    color: var(--text);
    font-size: .84rem;
    line-height: 1.3;
    margin-bottom: .2rem;
    transition: color .15s;
  }
  .side-list a:hover .side-post-title { color: var(--indigo); }
  .side-list time { color: var(--muted); font-size: .7rem; }
  /* Scroll suave solo si el usuario no pidió reducir movimiento. */
  :global(html) { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
  }
  .hero-img {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    border-radius: 12px;
    border: 1px solid #504945;
    margin-bottom: 2rem;
  }
  .post-header { margin-bottom: 2rem; }
  .post-header h1 { font-size: 2.2rem; line-height: 1.2; margin-bottom: .8rem; }
  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: .6rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .chips { display: flex; gap: .35rem; flex-wrap: wrap; }
  .chips .tag { margin-top: 0; }
  .post-meta time { color: var(--muted); font-size: .85rem; }
  .meta-line { color: var(--muted); font-size: .9rem; margin-bottom: .8rem; }
  .description { color: var(--muted); font-size: 1.05rem; }

  .content { line-height: 1.75; }
  .content h2 { margin: 2rem 0 1rem; font-size: 1.6rem; scroll-margin-top: 1.5rem; }
  .content h3 { margin: 1.5rem 0 .8rem; font-size: 1.25rem; scroll-margin-top: 1.5rem; }
  .content h4 { margin: 1.4rem 0 .6rem; font-size: 1.05rem; }
  .content p { margin-bottom: 1.2rem; }
  .content ul, .content ol { margin: 0 0 1.2rem 1.5rem; }
  .content li { margin-bottom: .4rem; }
  .content strong { color: #fbf1c7; }
  .content code {
    background: rgba(43,33,224,.12);
    color: #d3869b;
    padding: .15rem .4rem;
    border-radius: 4px;
    font-size: .9em;
  }
  .content pre {
    background: #1d2021;
    border: 1px solid #504945;
    border-radius: 8px;
    padding: 1rem;
    overflow-x: auto;
    margin: 0 0 1.2rem;
  }
  .content pre code { background: none; color: #ebdbb2; padding: 0; }
  .content blockquote {
    border-left: 3px solid var(--indigo);
    padding-left: 1rem;
    color: var(--muted);
    margin: 0 0 1.2rem;
    font-style: italic;
  }
  .content img {
    max-width: 100%;
    border-radius: 8px;
    margin: 1rem 0;
  }
  .content a { color: #d3869b; }
  .content table {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 1.2rem;
    font-size: .95rem;
  }
  .content th, .content td {
    border: 1px solid #504945;
    padding: .5rem .8rem;
    text-align: left;
  }
  .content th { background: var(--card); }
  .content hr { border: none; border-top: 1px solid #504945; margin: 2rem 0; }

  .post-footer { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid #504945; }
  .post-footer a { color: var(--muted); text-decoration: none; }
  .post-footer a:hover { color: #d3869b; }
  .related { margin-top: 2.5rem; }
  .related h2 { font-size: 1.3rem; margin-bottom: 1rem; }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }
  .related-card {
    background: var(--card);
    border: 1px solid #504945;
    border-radius: 12px;
    padding: 1.1rem 1.25rem;
    transition: transform .2s, border-color .2s;
  }
  .related-card:hover { transform: translateY(-3px); border-color: var(--indigo); }
  .related-card .tag { margin-top: 0; margin-bottom: .6rem; }
  .related-card h3 { color: var(--text); font-size: 1rem; line-height: 1.35; margin-bottom: .5rem; }
  .related-card time { color: var(--muted); font-size: .8rem; }
</style>
