---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Adrian — Portafolio">
  <section class="hero">
    <h1>Hola, soy <span class="accent">Adrian</span> 👋<br />Desarrollador y creador de contenido tech.</h1>
    <p>Construyo productos con IA, NFC y web. Comparto lo que aprendo en mi blog y promuevo mis proyectos open source.</p>
  </section>

  <section class="grid">
    <div class="card">
      <h3>🪪 Identik</h3>
      <p>Identidad profesional con NFC + QR + PWA. Convierte cualquier objeto en tarjeta de presentación inteligente.</p>
      <span class="tag">NFC · QR · PWA</span>
    </div>
    <div class="card">
      <h3>📻 rAIdio</h3>
      <p>Radio personalizada con IA: noticias, clima y tráfico en un guion generado automáticamente.</p>
      <span class="tag">IA · Audio</span>
    </div>
    <div class="card">
      <h3>💬 Código Crítico</h3>
      <p>Divulgación de tecnología con pensamiento crítico. Por una IA al servicio de la humanidad.</p>
      <span class="tag">Contenido · IA</span>
    </div>
  </section>
</Layout>
