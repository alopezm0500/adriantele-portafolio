---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { catName, catColor } from '../lib/blog';
import PostCarousel from '../components/PostCarousel.astro';

const posts = await getCollection('blog');
const latestPosts = [...posts].sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
const count = (key: string) =>
  posts.filter((p) => (p.data.categories ?? []).includes(key)).length;

const SECTIONS: { key: string; icon: string; desc: string }[] = [
  {
    key: 'tech-en-rojo',
    icon: '⚠️',
    desc: 'Riesgos, sesgos, privacidad y regulación: los excesos de la tecnología bajo la lupa.',
  },
  {
    key: 'tech-humano',
    icon: '💬',
    desc: 'Cómo la tecnología nos cambia por dentro: atención, salud mental, psicología y hábitos.',
  },
  {
    key: 'techco-e-ia',
    icon: '🛠️',
    desc: 'Telecom, operaciones e IA: estándares y automatización contados desde la trinchera.',
  },
  {
    key: 'sociedad-y-telecom',
    icon: '📡',
    desc: 'Conectividad, regulación, espectro y brecha digital: la red vista como política pública.',
  },
  {
    key: 'technical',
    icon: '🔧',
    desc: 'Apuntes técnicos de redes y core: IMS, 4G/5G, señalización y operaciones en campo.',
  },
].filter((s) => count(s.key) > 0);

const siteUrl = Astro.site!.href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Tech con Sentido',
    url: siteUrl,
    inLanguage: 'es-MX',
    description:
      'Tecnología con pensamiento crítico: IA, telecom, privacidad, código abierto e impacto social.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Adrian López',
    url: siteUrl,
    jobTitle: 'Ingeniero en Telecomunicaciones',
    sameAs: ['https://github.com/alopezm0500'],
    knowsAbout: [
      'Telecomunicaciones',
      'IMS',
      'VoLTE',
      'Redes 5G',
      'Inteligencia artificial',
      'Software libre',
    ],
  },
];
---
<Layout title="Tech con Sentido" jsonLd={jsonLd}>
  <section class="hero">
    <div class="hero-text">
      <h1>Hola, soy <span class="accent">Adrian</span> 👋<br />Ingeniero Telecom, desarrollador, entusiasta y creador de contenido tech</h1>
      <p>Construyo productos con IA y software libre. Comparto lo que aprendo en mi blog y redes sociales.</p>
    </div>
    <aside class="ik-card">
      <div class="ik-body">
        <img class="ik-photo" src="/identik/adrian.png" alt="Foto de perfil de Adrian en Identik" width="80" height="80" />
        <div class="ik-id">
          <span class="ik-name">Adrian Lopez</span>
          <span class="ik-user">@adrian_l_m · Identik</span>
        </div>
      </div>
      <p class="ik-role">Ingeniero Telecom · AT&T Mexico</p>
      <p class="ik-bio">Líder Técnico | Core Voz VoLTE/VoWiFi/CS | Entusiasta de IA, Software Libre y Código abierto.</p>
      <div class="ik-foot">
        <img class="ik-qr" src="/identik/qr.png" alt="Código QR del perfil Identik de Adrian" width="76" height="76" />
        <a class="ik-cta" href="https://identik.lat/u/adrian_l_m" target="_blank" rel="noopener">
          Ver mi perfil
          <small>Pega. Toca. Conecta.</small>
        </a>
      </div>
    </aside>
  </section>

  <section class="blog-secs">
    <header class="blog-secs-head">
      <div>
        <h2>En el blog</h2>
        <p>Escribo sobre tecnología con pensamiento crítico. Estas son las secciones que abordo:</p>
      </div>
      <a class="all" href="/blog">Ver todos →</a>
    </header>
    <div class="secs">
      {SECTIONS.map((s) => (
        <a class="sec" href={`/blog/categoria/${s.key}`} style={`--sec: ${catColor(s.key)}`}>
          <span class="sec-name">
            <span class="sec-icon">{s.icon}</span>
            {catName(s.key)}
          </span>
          <span class="sec-desc">{s.desc}</span>
          <span class="sec-meta">
            <span class="sec-count">
              {count(s.key)} {count(s.key) === 1 ? 'artículo' : 'artículos'}
            </span>
            <span class="sec-go">Leer →</span>
          </span>
        </a>
      ))}
    </div>

    <PostCarousel posts={latestPosts} limit={6} />

  </section>

  <section class="projects">
    <h2>Mis proyectos actuales</h2>
    <div class="grid">
      <div class="card">
        <h3>💬 Tech con Sentido</h3>
        <p>Divulgación de tecnología con pensamiento crítico. Por una IA al servicio de la humanidad.</p>
        <span class="tag">Contenido · IA</span>
      </div>
      <div class="card">
        <h3>🧠 Tech para Mortales</h3>
        <p>Divulgación y consultoría de tecnología para público general. Asesoría 1:1, productos digitales y talleres.</p>
        <span class="tag">Contenido · Consultoría</span>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 2.5rem;
    align-items: center;
  }
  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }
  .ik-card {
    background: var(--card);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 1.1rem 1.25rem 1.25rem;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.35);
  }
  .ik-body {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 0.4rem;
  }
  .ik-photo {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 50%;
    border: 2px solid var(--indigo);
  }
  .ik-id {
    display: flex;
    flex-direction: column;
  }
  .ik-name {
    font-size: 1.2rem;
    font-weight: 700;
  }
  .ik-user {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .ik-role {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--indigo);
    margin-bottom: 0.3rem;
  }
  .ik-bio {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.5;
  }
  .ik-foot {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }
  .ik-qr {
    width: 76px;
    height: 76px;
    border-radius: 8px;
  }
  .ik-cta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--indigo);
    text-decoration: none;
  }
  .ik-cta small {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--muted);
  }
  .ik-cta:hover small {
    color: var(--text);
  }
  .blog-secs {
    margin-bottom: 3.5rem;
  }
  .blog-secs-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }
  .blog-secs-head h2 {
    font-size: 1.7rem;
    margin: 0;
  }
  .blog-secs-head p {
    color: var(--muted);
    margin: 0.35rem 0 0;
  }
  .blog-secs-head .all {
    color: var(--indigo);
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
  }
  .secs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .blog-note {
    margin: 1.25rem 0 0;
    padding: 0.9rem 1.1rem;
    font-size: 0.9rem;
    color: var(--muted);
    background: var(--card);
    border: 1px dashed rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    line-height: 1.5;
  }
  .blog-note a {
    color: var(--indigo);
    font-weight: 600;
    text-decoration: none;
  }
  .blog-note a:hover {
    text-decoration: underline;
  }
  .projects {
    margin-bottom: 3.5rem;
  }
  .projects h2 {
    font-size: 1.7rem;
    margin: 0 0 1.25rem;
  }
  .projects .grid {
    margin-top: 0;
  }
  .sec {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.15rem 1.25rem;
    background: var(--card);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-top: 3px solid var(--sec);
    border-radius: 14px;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .sec:hover {
    border-color: var(--sec);
    transform: translateY(-2px);
  }
  .sec-name {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text);
  }
  .sec-icon {
    margin-right: 0.4rem;
  }
  .sec-desc {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.45;
    flex: 1;
  }
  .sec-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }
  .sec-count {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--sec);
    background: color-mix(in srgb, var(--sec) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--sec) 35%, transparent);
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
  }
  .sec-go {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--indigo);
  }
</style>
