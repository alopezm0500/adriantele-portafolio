---
// Página personal de lectura — "La cabeza que piensa de más".
// Ruta: /lectura/sobrepensar/ — uso privado de Adrián, noindex, no se enlaza desde el sitio.
import Hoja from '../../data/sobrepensar/hoja.md';

const site = Astro.site ?? new URL('https://adriantele-portafolio.pages.dev');
const canonical = new URL('/lectura/sobrepensar/', site);
const titulo = 'La cabeza que piensa de más';
const descripcion = 'Hoja personal de una página sobre rumiación: qué es, qué no es y cinco palancas.';
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#282828" />
    <style is:global>
      :root {
        --gb-bg: #282828;
        --gb-card: #3c3836;
        --gb-line: #504945;
        --gb-text: #ebdbb2;
        --gb-muted: #bdae93;
        --gb-accent: #83a598;
        --gb-link: #fabd2f;
        --gb-max: 760px;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        background: var(--gb-bg);
        color: var(--gb-text);
        font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial,
          sans-serif;
        font-size: 17px;
        line-height: 1.68;
        -webkit-text-size-adjust: 100%;
      }
      main {
        max-width: var(--gb-max);
        margin: 0 auto;
        padding: 28px 18px 96px;
      }
      h1 {
        font-size: clamp(1.6rem, 4.6vw, 2.1rem);
        line-height: 1.24;
        margin: 0 0 18px;
      }
      h2 {
        font-size: clamp(1.18rem, 3.2vw, 1.4rem);
        line-height: 1.3;
        margin: 40px 0 12px;
        padding-top: 18px;
        border-top: 1px solid var(--gb-line);
      }
      p {
        margin: 0 0 15px;
      }
      ul,
      ol {
        margin: 0 0 16px;
        padding-left: 22px;
      }
      li {
        margin-bottom: 10px;
      }
      strong {
        color: #fbf1c7;
      }
      em {
        color: var(--gb-muted);
      }
      a {
        color: var(--gb-accent);
        text-decoration: none;
        border-bottom: 1px solid color-mix(in srgb, var(--gb-accent) 45%, transparent);
      }
      a:hover {
        color: var(--gb-link);
      }
      hr {
        border: 0;
        border-top: 1px solid var(--gb-line);
        margin: 32px 0;
      }
      .pie {
        margin-top: 48px;
        padding-top: 16px;
        border-top: 1px solid var(--gb-line);
        color: var(--gb-muted);
        font-size: 14px;
      }
    </style>
  </head>
  <body>
    <main>
      <article><Hoja /></article>
      <p class="pie">
        Hoja personal · 21-oct-2026 · Página privada (noindex, no enlazada desde el sitio).
      </p>
    </main>
  </body>
</html>
