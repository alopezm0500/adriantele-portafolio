---
// Página privada de lectura — manual de Helm (intro y comandos esenciales).
// Ruta: /lectura/helm-intro-y-comandos-esenciales/ — uso privado de Adrián, noindex, no se enlaza desde el sitio.
// Contenido importado desde src/data/helm-intro-y-comandos-esenciales/hoja.md
import Hoja from '../../data/helm-intro-y-comandos-esenciales/hoja.md';

const site = Astro.site ?? new URL('https://adriantele-portafolio.pages.dev');
const canonical = new URL('/lectura/helm-intro-y-comandos-esenciales/', site);
const titulo = 'Helm — intro y comandos esenciales';
const descripcion = 'Manual de Helm: chart, release, values y revisión; comandos por orden de uso, receta de diagnóstico y gotchas.';
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#282828" />
    <style is:global>
      :root {
        --gb-bg: #282828;
        --gb-card: #3c3836;
        --gb-line: #504945;
        --gb-text: #ebdbb2;
        --gb-muted: #bdae93;
        --gb-accent: #83a598;
        --gb-link: #fabd2f;
        --gb-max: 760px;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        background: var(--gb-bg);
        color: var(--gb-text);
        font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial,
          sans-serif;
        font-size: 17px;
        line-height: 1.68;
        -webkit-text-size-adjust: 100%;
      }
      main {
        max-width: var(--gb-max);
        margin: 0 auto;
        padding: 28px 18px 96px;
      }
      h1 {
        font-size: clamp(1.6rem, 4.6vw, 2.1rem);
        line-height: 1.24;
        margin: 0 0 18px;
      }
      h2 {
        font-size: clamp(1.18rem, 3.2vw, 1.4rem);
        line-height: 1.3;
        margin: 40px 0 12px;
        padding-top: 18px;
        border-top: 1px solid var(--gb-line);
      }
      h3 {
        font-size: 1.06rem;
        margin: 26px 0 8px;
      }
      p {
        margin: 0 0 15px;
      }
      ul,
      ol {
        margin: 0 0 16px;
        padding-left: 22px;
      }
      li {
        margin-bottom: 8px;
      }
      strong {
        color: #fbf1c7;
      }
      em {
        color: var(--gb-muted);
      }
      a {
        color: var(--gb-accent);
        text-decoration: none;
        border-bottom: 1px solid color-mix(in srgb, var(--gb-accent) 45%, transparent);
      }
      a:hover {
        color: var(--gb-link);
      }
      blockquote {
        margin: 0 0 20px;
        padding: 10px 16px;
        border-left: 3px solid var(--gb-accent);
        background: var(--gb-card);
        color: var(--gb-muted);
        border-radius: 0 6px 6px 0;
      }
      blockquote p:last-child {
        margin-bottom: 0;
      }
      code {
        font-family: ui-monospace, SFMono-Regular, 'JetBrains Mono', Menlo, Consolas, monospace;
        font-size: 0.9em;
        background: #1d2021;
        border: 1px solid var(--gb-line);
        border-radius: 4px;
        padding: 1px 5px;
        color: #fabd2f;
      }
      pre {
        background: #1d2021;
        border: 1px solid var(--gb-line);
        border-radius: 8px;
        padding: 14px 16px;
        overflow-x: auto;
        margin: 0 0 20px;
        font-size: 14px;
        line-height: 1.55;
      }
      pre code {
        background: none;
        border: 0;
        padding: 0;
        color: #ebdbb2;
        font-size: inherit;
      }
      hr {
        border: 0;
        border-top: 1px solid var(--gb-line);
        margin: 32px 0;
      }
      input[type='checkbox'] {
        accent-color: var(--gb-accent);
        margin-right: 6px;
      }
      .pie {
        margin-top: 48px;
        padding-top: 16px;
        border-top: 1px solid var(--gb-line);
        color: var(--gb-muted);
        font-size: 14px;
      }
    </style>
  </head>
  <body>
    <main>
      <article><Hoja /></article>
      <p class="pie">
        Manual de estudio · 13-oct-2026 · Página privada (noindex, no enlazada desde el sitio).
      </p>
    </main>
  </body>
</html>
