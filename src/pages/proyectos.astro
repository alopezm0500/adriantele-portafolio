---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Proyectos — Adrian">
  <h1>🚀 Proyectos</h1>
  <p style="color:var(--muted);margin-top:.5rem">Mis proyectos open source y productos.</p>
  <section class="grid">
    <div class="card">
      <h3>🪪 Identik</h3>
      <p>Identidad profesional NFC + QR + PWA.</p>
      <span class="tag">identik.lat</span>
    </div>
    <div class="card">
      <h3>📻 rAIdio</h3>
      <p>Radio personalizada con IA.</p>
      <span class="tag">IA · Audio</span>
    </div>
    <div class="card">
      <h3>🐾 Xhunco</h3>
      <p>App de salud para mascotas: expediente médico, recordatorios y conexión con tu veterinario.</p>
      <span class="tag">Salud · Mascotas</span>
    </div>
    <div class="card">
      <h3>🧠 Tech para Mortales</h3>
      <p>Divulgación y consultoría de tecnología para público general. Asesoría 1:1, productos digitales y talleres.</p>
      <span class="tag">Contenido · Consultoría</span>
    </div>
  </section>
</Layout>
