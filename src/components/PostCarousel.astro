---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { catColor, catName, fmtDate, readingTime } from '../lib/blog';

interface Props {
  posts: CollectionEntry<'blog'>[];
  limit?: number;
}

const { posts, limit = 6 } = Astro.props;
const slides = posts.slice(0, limit);
---

<section class="c-wrap" data-carousel title="Artículos recientes">
  <header class="c-head">
    <div>
      <h2>Lo más reciente</h2>
      <p class="c-sub">Desliza para explorar los últimos artículos</p>
    </div>
    <div class="c-nav">
      <button type="button" class="c-btn" data-carousel-prev aria-label="Artículos anteriores">‹</button>
      <button type="button" class="c-btn" data-carousel-next aria-label="Artículos siguientes">›</button>
    </div>
  </header>

  <ul class="c-track" data-carousel-track>
    {
      slides.map((post, i) => {
        const cat = post.data.categories?.[0] ?? 'sin-categoria';
        return (
          <li class="c-slide">
            <a class="c-card" href={`/blog/${post.slug}/`}>
              {post.data.heroImage ? (
                <Image
                  class="c-cover"
                  src={post.data.heroImage}
                  alt={`Portada de: ${post.data.title}`}
                  width={220}
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              ) : (
                <div class="c-cover c-cover-alt" style={`--cat:${catColor(cat)}`}>
                  <span>{catName(cat)}</span>
                </div>
              )}
              <div class="c-body">
                <span class="c-tag" style={`--cat:${catColor(cat)}`}>{catName(cat)}</span>
                <h3>{post.data.title}</h3>
                <span class="c-meta">
                  {fmtDate(post.data.pubDate)} · {readingTime(post.body)} min
                </span>
              </div>
            </a>
          </li>
        );
      })
    }
  </ul>

  <div class="c-dots" data-carousel-dots></div>
</section>

<script>
  function setupCarousel(root: HTMLElement) {
    if (root.dataset.ready === '1') return;
    root.dataset.ready = '1';

    const track = root.querySelector<HTMLElement>('[data-carousel-track]');
    const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const dotBox = root.querySelector<HTMLElement>('[data-carousel-dots]');
    if (!track || !prev || !next || !dotBox) return;

    const slides = Array.from(track.children) as HTMLElement[];
    if (slides.length < 2) return;

    const step = () => slides[0].getBoundingClientRect().width + 20;

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));

    slides.forEach((slide, i) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'c-dot';
      dot.setAttribute('aria-label', `Ir al artículo ${i + 1}`);
      dot.addEventListener('click', () =>
        slide.scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' })
      );
      dotBox.appendChild(dot);
    });

    const dots = Array.from(dotBox.children) as HTMLButtonElement[];

    const update = () => {
      const center = track.scrollLeft + track.clientWidth / 2;
      let active = 0;
      let best = Infinity;
      slides.forEach((slide, i) => {
        const mid = slide.offsetLeft + slide.offsetWidth / 2;
        const dist = Math.abs(mid - center);
        if (dist < best) {
          best = dist;
          active = i;
        }
      });
      dots.forEach((dot, i) => dot.classList.toggle('on', i === active));

      const max = track.scrollWidth - track.clientWidth - 2;
      root.classList.toggle('c-single', max <= 0);
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max;
    };

    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();

    // Autoplay: avanza solo, se pausa al interactuar
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer: number | undefined;

    const stop = () => {
      if (timer !== undefined) {
        clearInterval(timer);
        timer = undefined;
      }
    };

    const tick = () => {
      if (document.hidden) return;
      const max = track.scrollWidth - track.clientWidth - 2;
      if (max <= 0) {
        stop();
        return;
      }
      if (track.scrollLeft >= max - 2) {
        track.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        track.scrollBy({ left: step(), behavior: 'smooth' });
      }
    };

    const start = () => {
      if (reduce) return;
      stop();
      timer = window.setInterval(tick, 5000);
    };

    root.addEventListener('pointerenter', stop);
    root.addEventListener('pointerleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    root.addEventListener('touchstart', stop, { passive: true });
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    start();
  }

  function initCarousels() {
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(setupCarousel);
  }

  document.addEventListener('astro:page-load', initCarousels);
  if (document.readyState === 'complete') initCarousels();
</script>

<style>
  .c-wrap {
    margin-top: 1.5rem;
  }
  .c-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    margin-bottom: .7rem;
  }
  .c-head h2 {
    font-size: 1.12rem;
  }
  .c-sub {
    color: var(--muted);
    font-size: .78rem;
    margin-top: .1rem;
  }
  .c-nav {
    display: flex;
    gap: .5rem;
    flex: 0 0 auto;
  }
  .c-btn {
    width: 29px;
    height: 29px;
    border-radius: 50%;
    background: var(--card);
    border: 1px solid #504945;
    color: var(--text);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: border-color .2s, color .2s, opacity .2s;
  }
  .c-btn:hover:not(:disabled) {
    border-color: var(--indigo);
    color: #fbf1c7;
  }
  .c-btn:disabled {
    opacity: .3;
    cursor: default;
  }
  .c-track {
    list-style: none;
    display: flex;
    gap: .85rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: .25rem;
    padding: .25rem .25rem .5rem;
    margin: 0;
    scrollbar-width: none;
  }
  .c-track::-webkit-scrollbar {
    display: none;
  }
  .c-slide {
    flex: 0 0 min(258px, 72vw);
    scroll-snap-align: start;
    display: flex;
  }
  .c-card {
    display: flex;
    width: 100%;
    background: var(--card);
    border: 1px solid #504945;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    transition: transform .2s, border-color .2s;
  }
  .c-card:hover {
    transform: translateY(-2px);
    border-color: var(--indigo);
  }
  .c-cover {
    width: 84px;
    flex: 0 0 84px;
    align-self: stretch;
    min-height: 84px;
    object-fit: cover;
    display: block;
    border-right: 1px solid #504945;
  }
  .c-cover-alt {
    display: grid;
    place-items: center;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--cat) 48%, transparent),
      color-mix(in srgb, var(--cat) 12%, transparent)
    );
    color: #fbf1c7;
    font-weight: 600;
    font-size: .62rem;
    letter-spacing: .02em;
    text-align: center;
    padding: 0 4px;
  }
  .c-body {
    padding: .6rem .75rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: .3rem;
    flex: 1;
    min-width: 0;
  }
  .c-tag {
    --cat: #d3869b;
    display: inline-block;
    background: color-mix(in srgb, var(--cat) 20%, transparent);
    border: 1px solid color-mix(in srgb, var(--cat) 40%, transparent);
    color: color-mix(in srgb, var(--cat) 72%, #fbf1c7);
    font-weight: 600;
    font-size: .6rem;
    padding: .1rem .45rem;
    border-radius: 20px;
    white-space: nowrap;
    align-self: flex-start;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .c-body h3 {
    font-size: .86rem;
    line-height: 1.28;
    color: var(--text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .c-card:hover h3 {
    color: #d3869b;
  }
  .c-meta {
    color: var(--muted);
    font-size: .68rem;
    margin-top: auto;
    padding-top: .2rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .c-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: .4rem;
    margin-top: .45rem;
    min-height: 8px;
  }
  .c-dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #504945;
    cursor: pointer;
    transition: background .2s, width .2s;
  }
  .c-dot:hover {
    background: var(--muted);
  }
  .c-dot.on {
    background: #d3869b;
    width: 20px;
    border-radius: 4px;
  }
  .c-single .c-nav,
  .c-single .c-dots {
    display: none;
  }
  @media (max-width: 720px) {
    .c-head {
      align-items: flex-start;
    }
    .c-nav {
      display: none;
    }
    .c-slide {
      flex-basis: min(232px, 78vw);
    }
  }
</style>
