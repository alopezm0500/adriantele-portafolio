---
// Botón de "me gusta" sin login. Sin dependencias: un fetch al propio sitio
// (Pages Function /api/likes) y estado local en localStorage.
// Si el endpoint no responde, el botón se oculta: nunca se ve roto.
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div class="like-wrap" data-slug={slug} hidden>
  <button class="like-btn" type="button" aria-pressed="false" aria-label="Me gusta este artículo">
    <span class="heart" aria-hidden="true">🤍</span>
    <span class="label">Me gusta</span>
    <span class="count" hidden></span>
  </button>
</div>

<style>
  .like-wrap {
    display: flex;
    justify-content: center;
    margin: 2rem 0 1.25rem;
  }

  .like-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--indigo) 38%, transparent);
    border-radius: 999px;
    background: var(--card);
    color: var(--text);
    font: inherit;
    font-size: 0.95rem;
    cursor: pointer;
    transition:
      transform 0.12s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .like-btn:hover {
    border-color: var(--indigo);
    transform: translateY(-1px);
  }

  .like-btn:disabled {
    cursor: default;
    opacity: 0.65;
  }

  .like-btn.is-liked {
    border-color: var(--indigo);
    background: color-mix(in srgb, var(--indigo) 14%, var(--card));
  }

  .count {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .like-btn,
    .like-btn:hover {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  const wrap = document.querySelector<HTMLElement>('.like-wrap');
  const slug = wrap?.dataset.slug;

  if (wrap && slug) {
    const btn = wrap.querySelector<HTMLButtonElement>('.like-btn')!;
    const heart = wrap.querySelector<HTMLElement>('.heart')!;
    const label = wrap.querySelector<HTMLElement>('.label')!;
    const count = wrap.querySelector<HTMLElement>('.count')!;
    const storeKey = `tcs:liked:${slug}`;

    const paint = (n: number, liked: boolean) => {
      heart.textContent = liked ? '❤️' : '🤍';
      label.textContent = liked ? 'Te gusta' : 'Me gusta';
      count.textContent = n > 0 ? String(n) : '';
      count.hidden = n <= 0;
      btn.classList.toggle('is-liked', liked);
      btn.setAttribute('aria-pressed', String(liked));
    };

    const likedLocally = () => {
      try {
        return localStorage.getItem(storeKey) === '1';
      } catch {
        return false;
      }
    };

    const rememberLocally = (liked: boolean) => {
      try {
        localStorage.setItem(storeKey, liked ? '1' : '0');
      } catch {
        /* modo privado: no pasa nada */
      }
    };

    try {
      const res = await fetch(`/api/likes?slug=${encodeURIComponent(slug)}`, {
        headers: { accept: 'application/json' },
      });
      if (!res.ok) throw new Error('sin endpoint');
      const data = await res.json();
      paint(Number(data.count) || 0, Boolean(data.liked) || likedLocally());
      wrap.hidden = false;

      btn.addEventListener('click', async () => {
        const liked = btn.classList.contains('is-liked');
        btn.disabled = true;
        try {
          const r = await fetch('/api/likes', {
            method: liked ? 'DELETE' : 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ slug }),
          });
          if (!r.ok) throw new Error('fallo');
          const d = await r.json();
          paint(Number(d.count) || 0, Boolean(d.liked));
          rememberLocally(Boolean(d.liked));
        } catch {
          /* se queda como estaba; el botón vuelve a estar disponible */
        } finally {
          btn.disabled = false;
        }
      });
    } catch {
      /* sin endpoint (dev local o binding pendiente): el botón no se muestra */
    }
  }
</script>
