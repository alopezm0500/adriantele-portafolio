---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { catColor, catName, fmtDate, readingTime } from '../lib/blog';

interface Props {
  post: CollectionEntry<'blog'>;
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
const minutes = readingTime(post.body);
const hasCover = Boolean(post.data.heroImage);
---
<a
  class={`card post${hasCover ? '' : ' noimg'}`}
  href={`/blog/${post.slug}/`}
>
  {
    hasCover && (
      <Image
        class="cover"
        src={post.data.heroImage}
        alt={`Portada de: ${post.data.title}`}
        width={640}
        loading={eager ? 'eager' : 'lazy'}
      />
    )
  }
  <div class="body">
    <div class="post-meta">
      <div class="chips">
        {post.data.categories.map((c) => (
          <span class="tag" style={`--cat:${catColor(c)}`}>{catName(c)}</span>
        ))}
      </div>
      <time datetime={post.data.pubDate}>{fmtDate(post.data.pubDate)}</time>
    </div>
    <h3>{post.data.title}</h3>
    <p class="excerpt">{post.data.description}</p>
    <span class="readmore">
      {minutes} min de lectura · Leer →
    </span>
  </div>
</a>

<style>
  .post {
    text-decoration: none;
    display: grid;
    grid-template-columns: minmax(200px, 38%) 1fr;
    align-items: stretch;
    overflow: hidden;
    padding: 0;
  }
  .post.noimg {
    grid-template-columns: 1fr;
  }
  .cover {
    width: 100%;
    height: 100%;
    min-height: 200px;
    object-fit: cover;
    display: block;
    border-right: 1px solid #262a36;
  }
  .post .body {
    padding: 1.4rem 1.6rem 1.5rem;
    display: flex;
    flex-direction: column;
  }
  .post h3 {
    color: var(--text);
    font-size: 1.22rem;
    line-height: 1.3;
    margin-bottom: .5rem;
  }
  .post:hover h3 { color: #8b85ff; }
  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: .6rem;
    margin-bottom: .8rem;
    flex-wrap: wrap;
  }
  .chips { display: flex; gap: .35rem; flex-wrap: wrap; }
  .chips .tag { margin-top: 0; }
  .post-meta time {
    color: var(--muted);
    font-size: .78rem;
  }
  .excerpt {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: .9rem;
  }
  .readmore {
    color: #8b85ff;
    font-size: .85rem;
    margin-top: auto;
  }
  @media (max-width: 720px) {
    .post { grid-template-columns: 1fr; }
    .cover {
      min-height: 0;
      height: 170px;
      border-right: 0;
      border-bottom: 1px solid #262a36;
    }
  }
</style>
